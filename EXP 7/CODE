num <- 24

cat("Factors of", num, ":\n")
for(i in 1:num){
  if(num %% i == 0)
    print(i)
}

set.seed(123)
v <- sample(-50:50, 10)

cat("Random Vector:\n")
print(v)

cat("FizzBuzz Output:\n")
for(i in 1:100){
  if(i %% 3 == 0 & i %% 5 == 0){
    print("FizzBuzz")
  } else if(i %% 3 == 0){
    print("Fizz")
  } else if(i %% 5 == 0){
    print("Buzz")
  } else{
    print(i)
  }
}
